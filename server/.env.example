# OpsHub API (NestJS) environment
# Copy to .env and fill in. Never commit the real .env.

# Port the API listens on
PORT=3001

# MongoDB connection string
DATABASE_URL=mongodb://localhost:27017/opshub

# JWT signing secret. REQUIRED in production — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change_me_to_a_long_random_string_min_32_chars

# Access-token lifetime
JWT_EXPIRES=7d
