# OpsHub app (Expo) environment
# Copy to .env and fill in. Never commit the real .env.

# API base URL. Leave empty to auto-pick per platform
# (Android emulator -> http://10.0.2.2:3001, iOS sim/web -> http://localhost:3001).
# For a physical device set your machine's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3001
